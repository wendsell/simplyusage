# simplyusage settings. Copy to secrets.env and fill in (keep it chmod 600).
# Full walkthrough: https://wendsell.github.io/simplyusage/setup.html

# --- SimplyPrint ---
# API key: simplyprint.io/panel/user_settings/api
SIMPLYPRINT_API_KEY=
# Company ID: on the same API settings page
SIMPLYPRINT_COMPANY_ID=

# --- Printers ---
# Each printer gets a short prefix of your choice (here P1S and A1), listed in
# PRINTERS below. Per printer:
#   <P>_HOST             printer IP address
#   <P>_SERIAL           printer serial number
#   <P>_ACCESS_CODE      LAN access code (printer screen, network settings)
#   <P>_SIMPLYPRINT_ID   printer ID in SimplyPrint: run `list-printers`
#   <P>_SOURCE           bridge-log (recommended: reads the SimplyPrint bridge's
#                        logs, uses no printer connection) or mqtt (own LAN
#                        connection; printers only allow a few)
#   <P>_EXTERNAL_EXT     optional: SimplyPrint extruder number of the external
#                        spool holder; unset = external-spool prints are skipped

P1S_HOST=
P1S_SERIAL=
P1S_ACCESS_CODE=
P1S_SIMPLYPRINT_ID=
P1S_SOURCE=bridge-log
# P1S_EXTERNAL_EXT=

A1_HOST=
A1_SERIAL=
A1_ACCESS_CODE=
A1_SIMPLYPRINT_ID=
A1_SOURCE=bridge-log

PRINTERS=P1S,A1

# --- Service ---
# true = log what would be deducted without writing to SimplyPrint.
# Start with true, check a test print, then switch to false.
DRY_RUN=true
# Seconds to wait after a job ends before checking whether SimplyPrint
# already recorded usage for it (avoids double counting its own jobs)
DEDUP_DELAY=60
