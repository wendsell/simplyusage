# Copy to secrets.env and fill in. secrets.env is gitignored.

# --- SimplyPrint ---
# API key: simplyprint.io/panel/user_settings/api
SIMPLYPRINT_API_KEY=
# Company ID: the number in your panel URLs / shown on the API page
SIMPLYPRINT_COMPANY_ID=

# --- Printer: P1S ---
P1S_HOST=
P1S_SERIAL=
# Settings -> Network on the printer screen
P1S_ACCESS_CODE=
# Printer ID in SimplyPrint (printers/Get)
P1S_SIMPLYPRINT_ID=
# Optional: SimplyPrint extruder index used for the external spool holder.
# Leave unset to skip external-spool prints (logged as unmapped).
# P1S_EXTERNAL_EXT=

# --- Printer: A1 ---
A1_HOST=
A1_SERIAL=
A1_ACCESS_CODE=
A1_SIMPLYPRINT_ID=
# How to get printer events: "mqtt" (own LAN connection, default) or
# "bridge-log" (tail the SimplyPrint bridge's logs; for printers like the A1
# that allow only one MQTT connection, which the bridge already holds).
A1_SOURCE=bridge-log

# --- Service ---
# Which printer prefixes above to watch
PRINTERS=P1S,A1
# true = log what would be deducted, don't write to SimplyPrint
DRY_RUN=false
# Seconds to wait after a job ends before checking whether SimplyPrint
# already recorded usage for it (avoids double counting its own jobs)
DEDUP_DELAY=60
