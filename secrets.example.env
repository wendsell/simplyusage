# Copy to secrets.env and fill in. secrets.env is gitignored.

# --- SimplyPrint ---
# API key: simplyprint.io/panel/user_settings/api
SIMPLYPRINT_API_KEY=
# Company ID: the number in your panel URLs / shown on the API page
SIMPLYPRINT_COMPANY_ID=

# --- Printer: P1S ---
P1S_HOST=
P1S_SERIAL=
# Settings -> Network on the printer screen
P1S_ACCESS_CODE=

# --- Printer: A1 ---
A1_HOST=
A1_SERIAL=
A1_ACCESS_CODE=
